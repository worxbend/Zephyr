<component type="desktop-application">
  <id>com.worxbend.zephyr</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Zephyr</name>
  <summary>Manage SDKMAN toolchains from the desktop</summary>
  <description>
    <p>
      Zephyr is a desktop interface for SDKMAN. It inventories installed JDKs
      and SDKs, reviews updates and local-only versions, and keeps all changes
      behind an explicit transaction preview.
    </p>
    <p>
      Zephyr uses the existing SDKMAN installation in your home directory and
      does not replace SDKMAN's package management.
    </p>
  </description>
  <launchable type="desktop-id">com.worxbend.zephyr.desktop</launchable>
  <provides>
    <binary>zephyr</binary>
  </provides>
